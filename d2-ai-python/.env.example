# 사용법: 이 파일을 .env 로 복사한 뒤 아래 "필수" 칸에 키를 넣는다.   cp .env.example .env
# .env 는 git 에 올라가지 않는다(.gitignore). 실제 키를 이 파일(.env.example)에 적지 않는다.
# 서버는 시작할 때 .env 를 읽는다. 터미널에서 export 한 값은 .env 보다 우선한다.
# 값이 없는 줄은 비워 두면 안 되는 것이고, 주석(#) 처리된 줄은 기본값이 있어 바꿀 때만 푼다.

# ══ 필수 ══════════════════════════════════════════════════════════════════

# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급. Gemini 답변(기본 모델)과 문서 임베딩에 쓴다
GOOGLE_API_KEY=

# Claude 로 답하거나(provider=claude) 폴백으로 쓸 때 필요하다. 쓰지 않으면 비워 둬도 서버는 뜬다
ANTHROPIC_API_KEY=

# ══ 접속 주소(기본값은 docker-compose.yml 로 띄운 로컬 컨테이너) ════════════════
# 기본값과 같으면 아래 줄을 풀 필요가 없다

# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# KAFKA_BOOTSTRAP=localhost:9092

# ══ 실험용(기본값으로 충분하다. 해당 Day 실험을 할 때만 바꾼다) ══════════════════

# ── Kafka 워커 ──
# KAFKA_TOPIC=agent.requests            # 요청 토픽(Spring 의 app.kafka.topics.requests 와 같아야 한다)
# KAFKA_GROUP=agent-workers             # 컨슈머 그룹
# KAFKA_WORKER_ID=                      # 워커 이름. 비우면 worker-<pid>. 여러 대를 띄울 때 w1, w2 처럼 준다
# KAFKA_CONSUMER_ENABLED=true           # false 면 HTTP 만 받고 Kafka 는 읽지 않는다
# KAFKA_COMMIT_MODE=manual
# KAFKA_OFFSET_RESET=latest
# KAFKA_RETRY_SEC=5
# KAFKA_HANDLER=agent
# KAFKA_DLQ_ENABLED=true                # 처리 실패 요청을 DLQ 토픽으로 보낸다
# KAFKA_DLQ_TOPIC=agent.requests.dlq

# ── 모델 ──
# GEMINI_MODEL=gemini-3.1-flash-lite    # 확인 스크립트(llm_check)에서 쓰는 모델 이름
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# OPENAI_API_KEY=                       # llm_check 에서만 쓴다
# OPENAI_MODEL=gpt-4o-mini
# AGENT_TIMEOUT_SEC=120                 # 에이전트 한 건 최대 시간
# AGENT_LOG_LEVEL=INFO                  # DEBUG 면 에이전트 내부 로그까지 나온다
# AGENT_DEBUG_DELAY_SEC=0               # 처리 중 일부러 기다리는 시간(워커를 처리 도중에 끄는 시험용)

# ── 가짜 모델(부하 시험용. 실제 모델을 호출하지 않는다) ──
# FAKE_LLM_ENABLED=false
# FAKE_LLM_DELAY_SEC=5
# FAKE_LLM_JITTER=0.2

# ── 모델 폴백과 장애 주입 ──
# MODEL_FAULT_INJECTION=false           # true 로 해야 MODEL_FORCE_DOWN 이 동작한다
# MODEL_FORCE_DOWN=                     # 일부러 실패시킬 모델 이름(쉼표로 구분)
# MODEL_BREAKER_THRESHOLD=3             # 연속 실패 몇 번에 차단하는가
# MODEL_BREAKER_COOLDOWN_SEC=30
# MODEL_DOWN_DELAY_SEC=0

# ── Redis 락, 대화 기록, 결과 저장 ──
# SESSION_LOCK_ENABLED=true             # 같은 세션 동시 처리를 막는 락
# REDIS_LOCK_TTL_SEC=150
# REDIS_LOCK_WAIT_SEC=100
# REDIS_LOCK_RETRY_SEC=0.1
# REDIS_CONNECT_TIMEOUT_SEC=1
# REDIS_SOCKET_TIMEOUT_SEC=2
# CONVERSATION_MAX_TURNS=10
# CONVERSATION_TTL_SEC=3600
# RESULT_PROCESSING_TTL_SEC=600
# RESULT_DONE_TTL_SEC=86400
# RESULT_TTL_SEC=                       # RESULT_DONE_TTL_SEC 의 옛 이름(DONE_TTL 이 없을 때만 쓴다)
# RESULT_FAILED_TTL_SEC=                # 비우면 RESULT_DONE_TTL_SEC 와 같다
# RESULT_STORE_MAX=1000
